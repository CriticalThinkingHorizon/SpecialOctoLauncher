' S2 / SmileBASIC 4.4.9 bootstrap. See README before RUN.
' Addresses are rediscovered; headers, native code and the SDK CRC are checked.
' REMOVE is issued once from Direct mode after RUN; its handled error is expected.
' START verifies the bootstrap, connects to the computer and runs the demo.

VAR NSR,B#,C#,T#,SH#,S#,M#,D#,G#,MM#,H$,QF$,GH$,DP$,CP$
VAR PHASE=0,FD=-1,POOL#=0,ZERO$=CHR$(0),ZI
FOR ZI=1 TO 18:ZERO$=ZERO$+ZERO$:NEXT
NSR=ARRAY$(4)
COPY NSR[0],0,"0000":COPY NSR[1],0,"1111"
COPY NSR[2],0,"2222":COPY NSR[3],0,"3333"
PRINT "DIST BOOT READY",1015
R
END
COMMON DEF P$(V#)
 VAR S$="",J
 FOR J=0 TO 3
  S$=S$+CHR$(V#-FLOOR(V#/65536)*65536):V#=FLOOR(V#/65536)
 NEXT
 RETURN S$
END
COMMON DEF U#(S$)
 VAR V#=0,J
 FOR J=3 TO 0 STEP -1:V#=V#*65536+ASC(MID$(S$,J,1)):NEXT
 RETURN V#
END
COMMON DEF HASH#(S$)
 VAR V#=0,J
 FOR J=0 TO LEN(S$)-1
  V#=V#*65599+ASC(MID$(S$,J,1))
  V#=V#-FLOOR(V#/2147483647)*2147483647
 NEXT
 RETURN V#
END
COMMON DEF PTR(V#,A)
 RETURN V#>0 && V#<549755813888 && V#==FLOOR(V#/A)*A
END
COMMON DEF FAIL(N)
 PHASE=-1
 PRINT "BOOT FAILED",N
 IF N==1 THEN PRINT "Already booted"
 IF N==2 THEN PRINT "Bad native pointer"
 IF N==3 THEN PRINT "Pointer order/spacing"
 IF N==4 THEN PRINT "Stack canary write"
 IF N==5 THEN PRINT "Canary byte order"
 IF N==6 THEN PRINT "Canary restore"
 IF N==7 THEN PRINT "Scratch handle bad"
 IF N==8 THEN PRINT "Scratch address/size bad"
 IF N==9 THEN PRINT "Scratch not writable"
 IF N==10 THEN PRINT "Key handle bad"
 IF N==11 THEN PRINT "SDK mapping not unique"
 IF N==12 THEN PRINT "Key header differs"
 IF N==13 THEN PRINT "Import table entry differs"
 IF N==14 THEN PRINT "Main header differs"
 IF N==15 THEN PRINT "SDK base invalid"
 IF N==16 THEN PRINT "SDK header differs"
 IF N==20 THEN PRINT "SDK section differs"
 IF N==21 THEN PRINT "SDK section differs"
 IF N==22 THEN PRINT "SDK section differs"
 IF N==23 THEN PRINT "SDK section differs"
 IF N==24 THEN PRINT "SDK section differs"
 IF N==25 THEN PRINT "SDK section differs"
 IF N==26 THEN PRINT "SDK section differs"
 IF N==27 THEN PRINT "SDK section differs"
 IF N==28 THEN PRINT "SDK section differs"
 IF N==39 THEN PRINT "Native state check failed"
 IF N==40 THEN PRINT "Call frame differs"
 IF N==41 THEN PRINT "Memmove self-test failed"
 IF N==42 THEN PRINT "Import restore failed"
 IF N==43 THEN PRINT "Memory query failed"
 IF N==44 THEN PRINT "SDK mapping type differs"
 IF N==45 THEN PRINT "SDK CRC differs"
 IF N==50 THEN PRINT "Bad port or IP"
 IF N==52 THEN PRINT "Network pool allocation failed"
 IF N==53 THEN PRINT "Network pool address bad"
 IF N==54 THEN PRINT "Network pool registration failed"
 IF N==55 THEN PRINT "Network service start failed"
 IF N==56 THEN PRINT "Network not ready"
 IF N==57 THEN PRINT "Socket open failed"
 IF N==58 THEN PRINT "Connect failed (host unreachable?)"
 IF N==59 THEN PRINT "Hello send failed"
 IF N==60 THEN PRINT "RPC entered without connection"
 RETURN 0
END
COMMON DEF DUMP S$
 VAR J
 FOR J=0 TO LEN(S$)-1
  PRINT HEX$(ASC(MID$(S$,J,1)),4);
  IF (J AND 3)==3 THEN PRINT
 NEXT
END
COMMON DEF W$(A#,N)
 VAR S$
 COPY NSR[2],0,P$(A#)+P$(N/2)
 S$=COPY(NSR[0],0,N/2):COPY NSR[2],0,H$
 RETURN S$
END
COMMON DEF PUT O,V#
 COPY NSR[1],O/2,P$(V#)
END
COMMON DEF CALL#(F,A#,B#,C#,E#)
 RETURN RAW#(P$(D#+F)+P$(A#)+P$(B#)+P$(C#)+P$(E#))
END
' Native SDK helper abstractions. Offsets are for the qualified SDK layout.
COMMON DEF SDK_MEMMOVE(DST#,SRC#,SIZE#,FLAGS#)
 RETURN CALL#(&H5872F0,DST#,SRC#,SIZE#,FLAGS#)
END
COMMON DEF SDK_QUERY_MEMORY(OUT#,INFO#,ADDRESS#)
 RETURN CALL#(&H158314,OUT#,INFO#,ADDRESS#,0)
END
COMMON DEF SDK_CRC32(START#,ADDRESS#,SIZE#)
 RETURN CALL#(463632,START#,ADDRESS#,SIZE#,0)
END
COMMON DEF NET_IS_INITIALIZED()
 RETURN CALL#(&H144DE0,0,0,0,0)
END
COMMON DEF NET_ALLOCATE_POOL(OUTPUT#,SIZE#,ADDRESS#)
 RETURN CALL#(&H577710,OUTPUT#,SIZE#,ADDRESS#,0)
END
COMMON DEF NET_REGISTER_POOL(POOL#,ADDRESS#,SIZE#,FLAGS#)
 RETURN CALL#(&H1453E0,POOL#,ADDRESS#,SIZE#,FLAGS#)
END
COMMON DEF NET_START()
 RETURN CALL#(&H3904A0,0,0,0,0)
END
COMMON DEF NET_SET_STATE(VALUE#)
 RETURN CALL#(&H391650,VALUE#,0,0,0)
END
COMMON DEF NET_RESET_STATE()
 RETURN CALL#(&H391480,0,0,0,0)
END
COMMON DEF NET_POLL_READY()
 RETURN CALL#(&H3915B0,0,0,0,0)
END
COMMON DEF SOCKET_OPEN(DOMAIN#,TYPE#)
 RETURN CALL#(&H14A210,DOMAIN#,TYPE#,0,0)
END
COMMON DEF SOCKET_CONNECT(FD#,ADDRESS#,SIZE#)
 RETURN CALL#(&H147AF0,FD#,ADDRESS#,SIZE#,0)
END
COMMON DEF SOCKET_SEND(FD#,ADDRESS#,SIZE#)
 RETURN CALL#(&H140BD0,FD#,ADDRESS#,SIZE#,0)
END
COMMON DEF SOCKET_RECEIVE(FD#,ADDRESS#,SIZE#,FLAGS#)
 RETURN CALL#(&H140B90,FD#,ADDRESS#,SIZE#,FLAGS#)
END
COMMON DEF SOCKET_CLOSE(FD#)
 RETURN CALL#(&H140D90,FD#,0,0,0)
END
COMMON DEF DISCONNECT
 VAR R#
 IF FD>=0 THEN
  R#=SOCKET_CLOSE(FD)
  FD=-1
 ENDIF
 IF PHASE>2 THEN PHASE=2
 WHILE INKEY$()!="":WEND
END
COMMON DEF RAW#(V$)
 COPY NSR[1],126976,QF$
 COPY NSR[1],1036,V$,0,4
 COPY NSR[1],127004,V$,4,4
 COPY NSR[1],127120,V$,8,4
 COPY NSR[1],127128,V$,12,8
 COPY NSR[2],0,GH$:COPY NSR[0],0,DP$
 COPY NSR[1],128,CP$:COPY NSR[2],0,H$
 RETURN U#(COPY(NSR[1],8216,4))
END
COMMON DEF BOOT()
 VAR V$,Q$,J,V#,L#,K#=0,FOUND=0,KH#,NATIVE#,CRC#,R#,ATTEMPT
 IF PHASE!=0 THEN RETURN FAIL(1)
 PHASE=1
 V$=COPY(NSR[0],0,16)
 FOR J=0 TO 3
  V#=U#(MID$(V$,J*4,4))
  IF !PTR(V#,16) THEN RETURN FAIL(2)
  IF J>0 && (V#<=U#(MID$(V$,(J-1)*4,4)) || V#-U#(LEFT$(V$,4))>=4096) THEN RETURN FAIL(3)
 NEXT
 B#=U#(LEFT$(V$,4)):C#=U#(MID$(V$,8,4))+16:T#=U#(MID$(V$,12,4))+16
 H$=P$(T#)+P$(4):COPY NSR[2],0,H$:COPY NSR[0],0,P$(C#)
 IF LEN(NSR[0])!=4 || NSR[0]!=NSR[3] || NSR[3]!="2222" THEN RETURN FAIL(4)
 COPY NSR[0],1,"9"
 IF NSR[3]!="2922" THEN RETURN FAIL(5)
 COPY NSR[0],1,"2"
 IF NSR[3]!="2222" THEN RETURN FAIL(6)
 Q$=COPY(ZERO$,0,2048)
 FOR ATTEMPT=0 TO 2
  NSR[1]=KEY(2):COPY NSR[2],0,P$(B#+8)+P$(4):KH#=U#(NSR[0]):COPY NSR[2],0,H$
  IF !PTR(KH#,16) THEN RETURN FAIL(10)
  COPY NSR[2],0,P$(FLOOR(KH#/4096)*4096)+P$(2048)
  COPY Q$,MIN(0,LEN(KEY(1)),LEN(KEY(2))),NSR[0]:COPY NSR[2],0,H$
  FOR J=0 TO 2040 STEP 8
   V#=U#(MID$(Q$,J,4)):L#=U#(MID$(Q$,J+4,4))
   IF L#==5 && PTR(V#-&H9DB49C,4096) THEN
    IF K#!=V# THEN K#=V#:FOUND=FOUND+1
   ENDIF
  NEXT
  IF FOUND!=0 THEN BREAK
 NEXT
 IF FOUND!=1 THEN RETURN FAIL(11)
 M#=K#-&H9DB49C
 IF W$(K#,10)!=KEY(2) THEN RETURN FAIL(12)
 IF U#(W$(FLOOR(K#/4096)*4096+&H170,8))!=M#+&H3854D0 THEN RETURN FAIL(13)
 IF HASH#(W$(M#,128))!=2137937599 THEN RETURN FAIL(14)
 Q$=W$(M#+&H9C9298,128):MM#=U#(MID$(Q$,44,4))
 D#=MM#-&H5872F0:G#=M#+&H9C92F0
 IF !PTR(D#,4096) || U#(MID$(Q$,40,4))!=D#+&H586FB0 THEN RETURN FAIL(15)
 IF HASH#(W$(D#,128))!=1437608693 THEN RETURN FAIL(16)
 IF HASH#(W$(D#+1242644,120))!=943625752 THEN RETURN FAIL(20)
 IF HASH#(W$(D#+1178912,16))!=1012566187 THEN RETURN FAIL(21)
 IF HASH#(W$(D#+310672,24))!=236409839 THEN RETURN FAIL(22)
 IF HASH#(W$(D#+3378856,56))!=260441352 THEN RETURN FAIL(23)
 IF HASH#(W$(D#+1621008,16))!=2075897594 THEN RETURN FAIL(24)
 IF HASH#(W$(D#+202056,52))!=1662332171 THEN RETURN FAIL(25)
 IF HASH#(W$(D#+5796592,380))!=1057474404 THEN RETURN FAIL(26)
 IF HASH#(W$(D#+1409812,24))!=1911277185 THEN RETURN FAIL(27)
 IF HASH#(W$(D#+463632,512))!=301599630 THEN RETURN FAIL(28)
 NSR[1]=CHR$(0):FOR J=1 TO 18:NSR[1]=NSR[1]+NSR[1]:NEXT
 SH#=U#(W$(B#+8,8))
 IF !PTR(SH#,16) THEN RETURN FAIL(7)
 Q$=W$(SH#,16):S#=U#(LEFT$(Q$,4))
 IF !PTR(S#,16) || U#(MID$(Q$,4,4))!=262144 THEN RETURN FAIL(8)
 H$=P$(S#)+P$(4):COPY NSR[2],0,H$
 IF NSR[0]!=LEFT$(ZERO$,4) THEN RETURN FAIL(9)
 PUT 552,S#+&H900
 PUT 2072,D#+&H5872F0
 PUT 2176,S#+&H7B0
 PUT 2336,D#+&H12F614
 PUT 16432,1
 PUT 253960,MM#
 PUT 253968,G#
 PUT 253976,S#+&H880
 PUT 254008,S#+&H4040
 PUT 254048,D#+&H11FD20
 PUT 254200,D#+&H4BD90
 PUT 254232,D#+&H338EA8
 PUT 254240,S#+&H4080
 PUT 254256,32
 PUT 254264,0
 PUT 254440,D#+&H18BC10
 PUT 254496,S#+&H100
 PUT 254504,S#+&H4030
 PUT 254520,D#+&H31548
 PUT 254528,S#+&H200
 IF W$(S#+552,8)!=P$(S#+&H900) THEN RETURN FAIL(39)
 IF W$(S#+2072,8)!=P$(D#+&H5872F0) THEN RETURN FAIL(39)
 IF W$(S#+2176,8)!=P$(S#+&H7B0) THEN RETURN FAIL(39)
 IF W$(S#+2336,8)!=P$(D#+&H12F614) THEN RETURN FAIL(39)
 IF W$(S#+16432,8)!=P$(1) THEN RETURN FAIL(39)
 IF W$(S#+253960,8)!=P$(MM#) THEN RETURN FAIL(39)
 IF W$(S#+253968,8)!=P$(G#) THEN RETURN FAIL(39)
 IF W$(S#+253976,8)!=P$(S#+&H880) THEN RETURN FAIL(39)
 IF W$(S#+254008,8)!=P$(S#+&H4040) THEN RETURN FAIL(39)
 IF W$(S#+254048,8)!=P$(D#+&H11FD20) THEN RETURN FAIL(39)
 IF W$(S#+254200,8)!=P$(D#+&H4BD90) THEN RETURN FAIL(39)
 IF W$(S#+254232,8)!=P$(D#+&H338EA8) THEN RETURN FAIL(39)
 IF W$(S#+254240,8)!=P$(S#+&H4080) THEN RETURN FAIL(39)
 IF W$(S#+254256,8)!=P$(32) THEN RETURN FAIL(39)
 IF W$(S#+254264,8)!=P$(0) THEN RETURN FAIL(39)
 IF W$(S#+254440,8)!=P$(D#+&H18BC10) THEN RETURN FAIL(39)
 IF W$(S#+254496,8)!=P$(S#+&H100) THEN RETURN FAIL(39)
 IF W$(S#+254504,8)!=P$(S#+&H4030) THEN RETURN FAIL(39)
 IF W$(S#+254520,8)!=P$(D#+&H31548) THEN RETURN FAIL(39)
 IF W$(S#+254528,8)!=P$(S#+&H200) THEN RETURN FAIL(39)
 QF$=COPY(NSR[1],126976,296)
 IF W$(S#+&H3E000,592)!=QF$ THEN RETURN FAIL(40)
 GH$=P$(G#)+P$(4):DP$=P$(D#+&H12F614):CP$=P$(S#+&H3E000)
 COPY NSR[1],&H2040,"NS2DISTCHECK1234"
 R#=SDK_MEMMOVE(S#+&H4040,S#+&H4080,32,0)
 IF R#!=S#+&H4040 || COPY(NSR[1],&H2020,16)!="NS2DISTCHECK1234" THEN RETURN FAIL(41)
 IF U#(W$(G#,8))!=MM# || NSR[0]!=LEFT$(ZERO$,4) THEN RETURN FAIL(42)
 R#=SDK_QUERY_MEMORY(S#+&H4100,S#+&H4140,D#)
 Q$=COPY(NSR[1],&H2080,32)
 IF R#!=0 || U#(LEFT$(Q$,4))!=D# || U#(MID$(Q$,4,4))!=6164480 THEN RETURN FAIL(43)
 IF U#(MID$(Q$,8,4))!=3 || U#(MID$(Q$,12,4))!=5 THEN RETURN FAIL(44)
 CRC#=SDK_CRC32(0,D#,6164480)
 IF CRC#!=3925528160 THEN RETURN FAIL(45)
 PHASE=2:CLS:PRINT "BINDINGS"
 DUMP P$(B#)+P$(C#)+P$(T#)+P$(SH#)+P$(S#)+P$(M#)+P$(D#)+P$(G#)+P$(MM#)
 PRINT "BOOT OK",CRC#:RETURN 1
END
COMMON DEF START(PORT,A,B,C,D)
 VAR R#,J,A$,HELLO$
 IF PHASE==0 THEN
  IF !BOOT() THEN RETURN 0
 ENDIF
 IF PHASE!=2 THEN DISCONNECT
 IF PORT<1024 OR PORT>65535 THEN RETURN FAIL(50)
 IF MIN(A,B,C,D)<0 OR MAX(A,B,C,D)>255 THEN RETURN FAIL(50)
 PHASE=3
 IF NET_IS_INITIALIZED()==0 THEN
  IF NET_ALLOCATE_POOL(S#+&H5100,4096,&H400000)!=0 THEN RETURN FAIL(52)
  POOL#=U#(COPY(NSR[1],&H2880,4))
  IF !PTR(POOL#,4096) THEN RETURN FAIL(53)
  IF NET_REGISTER_POOL(POOL#,&H400000,&H80000,4)!=0 THEN RETURN FAIL(54)
 ENDIF
 IF NET_START()!=0 THEN RETURN FAIL(55)
 R#=NET_SET_STATE(1):R#=NET_RESET_STATE()
 FOR J=0 TO 3599
  R#=NET_POLL_READY():IF R#==1 THEN BREAK
  VSYNC
 NEXT
 IF R#!=1 THEN RETURN FAIL(56)
 FD=SOCKET_OPEN(2,1)
 IF FD<0 OR FD>4095 THEN RETURN FAIL(57)
 A$=CHR$(&H210)+CHR$(FLOOR(PORT/256)+(PORT MOD 256)*256)+CHR$(A+B*256)+CHR$(C+D*256)+P$(0)
 COPY NSR[1],&H2900,A$
 IF SOCKET_CONNECT(FD,S#+&H5200,16)!=0 THEN RETURN FAIL(58)
 HELLO$=P$(&H31545344)+P$(1)+P$(2)+P$(S#)+P$(&H80000)+P$(M#)+P$(D#)+P$(G#)+P$(MM#)+P$(B#)+P$(C#)
 HELLO$=HELLO$+P$(0)+P$(0)+P$(0)+P$(0)+P$(3925528160)
 COPY NSR[1],&H2A00,HELLO$
 IF SOCKET_SEND(FD,S#+&H5400,128)!=128 THEN RETURN FAIL(59)
 PHASE=4:PRINT "HOST CONNECTED":RETURN RPC()
END
COMMON DEF RPC()
 VAR R#,V$,FIRST$,LAST$
 IF PHASE!=4 THEN RETURN FAIL(60)
 PHASE=5:PRINT "RPC RUNNING"
 WHILE 1
  R#=SOCKET_RECEIVE(FD,S#+&H40000,&H8080,&H40)
  IF R#!=&H8080 THEN BREAK
  V$=COPY(NSR[1],&H20000,40)
  IF LEFT$(V$,20)==CHR$(0)*20 THEN BREAK
  R#=RAW#(LEFT$(V$,20))
  FIRST$=COPY(NSR[1],8216,4)
  R#=RAW#(MID$(V$,20,20))
  COPY NSR[1],8220,FIRST$
  R#=SOCKET_SEND(FD,S#+&H4030,&H8010)
  IF R#!=&H8010 THEN BREAK
 WEND
 DISCONNECT
 PRINT "RPC STOP",R#
 IF U#(W$(S#+&H7D000,8))==&H41505053 THEN
  PRINT "OFFLINE APPS READY"
  RETURN LOCAL_DISPATCHER()
 ENDIF
 RETURN 1
END
COMMON DEF LOCAL_SWITCH(SLOT)
 VAR TB#,E#,CS#,SS#,AS#,AL#,MP#,CP#,R#,MSK#
 TB#=S#+&H7D000
 E#=TB#+64+SLOT*64
 CS#=U#(W$(E#,8))
 SS#=U#(W$(E#+16,8))
 AS#=U#(W$(E#+32,8))
 AL#=U#(W$(E#+40,8))
 MP#=U#(W$(TB#+40,8))
 CP#=U#(W$(TB#+48,8))
 R#=SDK_MEMMOVE(CP#+&H1000,CS#,512,0)
 VSYNC:VSYNC
 R#=SDK_MEMMOVE(MP#+&H7F0000+4100,S#+&H4000,1048,0)
 R#=SDK_MEMMOVE(MP#+1024,AS#,AL#,0)
 R#=SDK_MEMMOVE(MP#+784,SS#,240,0)
 R#=SDK_MEMMOVE(MP#+1016,S#+&H4000,8,0)
 PUT &H4200,SLOT:R#=SDK_MEMMOVE(TB#+24,S#+&H4200,8,0)
 IF SLOT==0 THEN
  MSK#=U#(W$(TB#+32,8))
  PUT &H4200,MSK#:R#=SDK_MEMMOVE(MP#+992,S#+&H4200,4,0)
 ENDIF
END
COMMON DEF LOCAL_DISPATCHER()
 VAR TB#,MP#,ST$,EF#,AC#,AS#,CNT#,TS#,R#
 TB#=S#+&H7D000
 IF U#(W$(TB#,8))!=&H41505053 THEN
  PRINT "NO CACHED APPS"
  RETURN 0
 ENDIF
 MP#=U#(W$(TB#+40,8))
 PRINT "LOCAL DISPATCHER RUNNING"
 PRINT "PRESS MINUS IN LAUNCHER TO EXIT"
 WHILE 1
  ST$=W$(MP#+1016,8)
  EF#=ASC(MID$(ST$,0,1))+ASC(MID$(ST$,1,1))*65536
  AC#=ASC(MID$(ST$,2,1))+ASC(MID$(ST$,3,1))*65536
  AS#=U#(W$(TB#+24,8))
  CNT#=U#(W$(TB#+16,8))
  IF EF#!=0 THEN
   IF AS#==0 THEN
    IF AC#==98 THEN
     PRINT "EXIT TO SB4"
     BREAK
    ENDIF
    IF AC#>0 THEN
     TS#=AC#
     IF TS#<CNT# THEN
      IF U#(W$(TB#+64+TS#*64+48,8))!=0 THEN
       LOCAL_SWITCH TS#
      ELSE
       R#=SDK_MEMMOVE(MP#+1016,S#+&H4000,8,0)
      ENDIF
     ELSE
      R#=SDK_MEMMOVE(MP#+1016,S#+&H4000,8,0)
     ENDIF
    ENDIF
   ELSE
    LOCAL_SWITCH 0
   ENDIF
  ENDIF
  IF INKEY$()!="" THEN BREAK
  VSYNC
 WEND
 PRINT "DISPATCHER STOP"
 RETURN 1
END
COMMON DEF OFFLINE
 IF PHASE==0 THEN
  IF !BOOT() THEN RETURN 0
 ENDIF
 RETURN LOCAL_DISPATCHER()
END
