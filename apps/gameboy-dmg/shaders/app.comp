#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=144) in;
#include "abi.glsl"
#include "hb.glsl"
#include "dmg.glsl"

// -----------------------------------------------------------------------------
// Workgroup Shared State for 144-Thread Parallel Scanline PPU Rendering
// -----------------------------------------------------------------------------
shared uint sDoRender;
shared uvec2 sLineRegs[144]; // .x = LCDC|(BGP<<8)|(OBP0<<16)|(OBP1<<24), .y = SCX|(SCY<<8)|(WX<<16)|(WY<<24)
shared uint sOAM[40];        // Cached 160-byte OAM table in fast on-chip shared memory

// -----------------------------------------------------------------------------
// Sharp LR35902 Local CPU & I/O Registers (Thread 0, loaded/saved to GB_CPU_BASE)
// -----------------------------------------------------------------------------
uint rA, rF, rBCDE, rHL;
uint rSP, rPC, rIME, rHalted;
uint rLCDC, rSTAT, rSCY, rSCX, rLY, rLYC, rBGP, rOBP0, rOBP1, rWY, rWX;
uint rIF, rIE, rDIV, rTIMA, rTMA, rTAC;
uint rRomBank, rRamBank, rMbcType, rMbcMode, rJoypSel, rFrames;
uint rDmaSrc;  // Non-zero (0x10000 | srcAddr) when $FF46 OAM DMA transfer is triggered
uint gButtons; // Current S2 controller button bitmask

const uint FLAG_Z = 0x80u;
const uint FLAG_N = 0x40u;
const uint FLAG_H = 0x20u;
const uint FLAG_C = 0x10u;

void gbWriteByteAt(uint baseWord, uint byteOffset, uint val) {
    uint idx = baseWord + (byteOffset >> 2u);
    uint shift = (byteOffset & 3u) * 8u;
    c.atlas[idx] = (c.atlas[idx] & ~(0xFFu << shift)) | ((val & 0xFFu) << shift);
}

uint getAF() { return ((rA & 0xFFu) << 8u) | (rF & 0xF0u); }
uint getBC() { return (((rBCDE >> 0u) & 0xFFu) << 8u) | ((rBCDE >> 8u) & 0xFFu); }
uint getDE() { return (((rBCDE >> 16u) & 0xFFu) << 8u) | ((rBCDE >> 24u) & 0xFFu); }
uint getHL() { return rHL & 0xFFFFu; }

void setAF(uint v) { rA = (v >> 8u) & 0xFFu; rF = v & 0xF0u; }
void setBC(uint v) { rBCDE = (rBCDE & 0xFFFF0000u) | (((v >> 8u) & 0xFFu) << 0u) | ((v & 0xFFu) << 8u); }
void setDE(uint v) { rBCDE = (rBCDE & 0x0000FFFFu) | (((v >> 8u) & 0xFFu) << 16u) | ((v & 0xFFu) << 24u); }
void setHL(uint v) { rHL = v & 0xFFFFu; }

void loadCPUState() {
    setAF(c.atlas[GB_CPU_BASE + 0u]);
    setBC(c.atlas[GB_CPU_BASE + 1u]);
    setDE(c.atlas[GB_CPU_BASE + 2u]);
    setHL(c.atlas[GB_CPU_BASE + 3u]);
    rSP      = c.atlas[GB_CPU_BASE + 4u] & 0xFFFFu;
    rPC      = c.atlas[GB_CPU_BASE + 5u] & 0xFFFFu;
    rIME     = c.atlas[GB_CPU_BASE + 6u];
    rHalted  = c.atlas[GB_CPU_BASE + 7u];
    rLCDC    = c.atlas[GB_CPU_BASE + 8u] & 0xFFu;
    rSTAT    = c.atlas[GB_CPU_BASE + 9u] & 0xFFu;
    rSCY     = c.atlas[GB_CPU_BASE + 10u] & 0xFFu;
    rSCX     = c.atlas[GB_CPU_BASE + 11u] & 0xFFu;
    rLY      = c.atlas[GB_CPU_BASE + 12u] & 0xFFu;
    rLYC     = c.atlas[GB_CPU_BASE + 13u] & 0xFFu;
    rBGP     = c.atlas[GB_CPU_BASE + 14u] & 0xFFu;
    rOBP0    = c.atlas[GB_CPU_BASE + 15u] & 0xFFu;
    rOBP1    = c.atlas[GB_CPU_BASE + 16u] & 0xFFu;
    rWY      = c.atlas[GB_CPU_BASE + 17u] & 0xFFu;
    rWX      = c.atlas[GB_CPU_BASE + 18u] & 0xFFu;
    rIF      = c.atlas[GB_CPU_BASE + 19u] & 0xFFu;
    rIE      = c.atlas[GB_CPU_BASE + 20u] & 0xFFu;
    rDIV     = c.atlas[GB_CPU_BASE + 21u] & 0xFFFFu;
    rTIMA    = c.atlas[GB_CPU_BASE + 22u] & 0xFFu;
    rTMA     = c.atlas[GB_CPU_BASE + 23u] & 0xFFu;
    rTAC     = c.atlas[GB_CPU_BASE + 24u] & 0xFFu;
    rRomBank = max(c.atlas[GB_CPU_BASE + 25u], 1u);
    rRamBank = c.atlas[GB_CPU_BASE + 26u] & 3u;
    rMbcType = c.atlas[GB_CPU_BASE + 27u];
    rMbcMode = c.atlas[GB_CPU_BASE + 28u];
    rJoypSel = c.atlas[GB_CPU_BASE + 29u] & 0x30u;
    rFrames  = c.atlas[GB_CPU_BASE + 30u];
    rDmaSrc  = 0u;
}

void saveCPUState() {
    c.atlas[GB_CPU_BASE + 0u]  = getAF();
    c.atlas[GB_CPU_BASE + 1u]  = getBC();
    c.atlas[GB_CPU_BASE + 2u]  = getDE();
    c.atlas[GB_CPU_BASE + 3u]  = getHL();
    c.atlas[GB_CPU_BASE + 4u]  = rSP & 0xFFFFu;
    c.atlas[GB_CPU_BASE + 5u]  = rPC & 0xFFFFu;
    c.atlas[GB_CPU_BASE + 6u]  = rIME;
    c.atlas[GB_CPU_BASE + 7u]  = rHalted;
    c.atlas[GB_CPU_BASE + 8u]  = rLCDC;
    c.atlas[GB_CPU_BASE + 9u]  = rSTAT;
    c.atlas[GB_CPU_BASE + 10u] = rSCY;
    c.atlas[GB_CPU_BASE + 11u] = rSCX;
    c.atlas[GB_CPU_BASE + 12u] = rLY;
    c.atlas[GB_CPU_BASE + 13u] = rLYC;
    c.atlas[GB_CPU_BASE + 14u] = rBGP;
    c.atlas[GB_CPU_BASE + 15u] = rOBP0;
    c.atlas[GB_CPU_BASE + 16u] = rOBP1;
    c.atlas[GB_CPU_BASE + 17u] = rWY;
    c.atlas[GB_CPU_BASE + 18u] = rWX;
    c.atlas[GB_CPU_BASE + 19u] = rIF;
    c.atlas[GB_CPU_BASE + 20u] = rIE;
    c.atlas[GB_CPU_BASE + 21u] = rDIV;
    c.atlas[GB_CPU_BASE + 22u] = rTIMA;
    c.atlas[GB_CPU_BASE + 23u] = rTMA;
    c.atlas[GB_CPU_BASE + 24u] = rTAC;
    c.atlas[GB_CPU_BASE + 25u] = rRomBank;
    c.atlas[GB_CPU_BASE + 26u] = rRamBank;
    c.atlas[GB_CPU_BASE + 27u] = rMbcType;
    c.atlas[GB_CPU_BASE + 28u] = rMbcMode;
    c.atlas[GB_CPU_BASE + 29u] = rJoypSel;
    c.atlas[GB_CPU_BASE + 30u] = rFrames + 1u;
}

// -----------------------------------------------------------------------------
// DMG-01 Memory Bus (ROM + MBC1/MBC2/MBC3/MBC5, VRAM, ERAM, WRAM, OAM, I/O, HRAM)
// -----------------------------------------------------------------------------
uint readJOYP() {
    uint low = 0x0Fu;
    vec2 stick = hbStick(false);
    if ((rJoypSel & 0x10u) == 0u) {
        if ((gButtons & HB_RIGHT) != 0u || stick.x >  0.35) low &= ~0x01u;
        if ((gButtons & HB_LEFT)  != 0u || stick.x < -0.35) low &= ~0x02u;
        if ((gButtons & HB_UP)    != 0u || stick.y < -0.35) low &= ~0x04u;
        if ((gButtons & HB_DOWN)  != 0u || stick.y >  0.35) low &= ~0x08u;
    }
    if ((rJoypSel & 0x20u) == 0u) {
        if ((gButtons & HB_A) != 0u)          low &= ~0x01u;
        if ((gButtons & HB_B) != 0u)          low &= ~0x02u;
        if ((gButtons & (HB_L | HB_R)) != 0u) low &= ~0x04u;
        if ((gButtons & HB_PLUS) != 0u)       low &= ~0x08u;
    }
    return 0xC0u | (rJoypSel & 0x30u) | low;
}

uint memRead(uint addr) {
    addr &= 0xFFFFu;
    if (addr < 0x4000u) return gbReadByteAt(GB_ROM_BASE, addr);
    if (addr < 0x8000u) {
        uint bank = max(rRomBank, 1u) & 15u;
        return gbReadByteAt(GB_ROM_BASE, ((bank * 0x4000u) + (addr - 0x4000u)) & 0x3FFFFu);
    }
    if (addr < 0xA000u) return gbReadByteAt(GB_VRAM_BASE, addr - 0x8000u);
    if (addr < 0xC000u) {
        uint ramOff = (rMbcType == 5u || rMbcType == 6u) ? ((addr - 0xA000u) & 0x01FFu) : ((addr - 0xA000u) & 0x1FFFu);
        return gbReadByteAt(GB_ERAM_BASE, ramOff);
    }
    if (addr < 0xFE00u) return gbReadByteAt(GB_WRAM_BASE, (addr - 0xC000u) & 0x1FFFu);
    if (addr < 0xFEA0u) return gbReadByteAt(GB_OAM_BASE, addr - 0xFE00u);
    if (addr < 0xFF00u) return 0xFFu;
    if (addr < 0xFF80u) {
        if (addr == 0xFF00u) return readJOYP();
        if (addr == 0xFF04u) return (rDIV >> 8u) & 0xFFu;
        if (addr == 0xFF05u) return rTIMA;
        if (addr == 0xFF06u) return rTMA;
        if (addr == 0xFF07u) return rTAC | 0xF8u;
        if (addr == 0xFF0Fu) return rIF | 0xE0u;
        if (addr == 0xFF40u) return rLCDC;
        if (addr == 0xFF41u) return rSTAT | 0x80u;
        if (addr == 0xFF42u) return rSCY;
        if (addr == 0xFF43u) return rSCX;
        if (addr == 0xFF44u) return rLY;
        if (addr == 0xFF45u) return rLYC;
        if (addr == 0xFF47u) return rBGP;
        if (addr == 0xFF48u) return rOBP0;
        if (addr == 0xFF49u) return rOBP1;
        if (addr == 0xFF4Au) return rWY;
        if (addr == 0xFF4Bu) return rWX;
        return gbReadByteAt(GB_IO_BASE, addr - 0xFF00u);
    }
    if (addr < 0xFFFFu) return gbReadByteAt(GB_HRAM_BASE, addr - 0xFF80u);
    return rIE;
}

void memWrite(uint addr, uint val) {
    addr &= 0xFFFFu;
    val &= 0xFFu;
    if (addr < 0x4000u) {
        if (rMbcType == 5u || rMbcType == 6u) {
            if ((addr & 0x0100u) != 0u) {
                uint b = val & 0x0Fu;
                rRomBank = (b == 0u) ? 1u : b;
            }
            return;
        }
        if (addr >= 0x2000u) {
            uint b = val & 0x1Fu;
            if (b == 0u) b = 1u;
            rRomBank = (rRomBank & 0x60u) | b;
        }
        return;
    }
    if (addr < 0x6000u) {
        if (rMbcType != 5u && rMbcType != 6u) {
            if (rMbcMode == 0u) {
                rRomBank = (rRomBank & 0x1Fu) | ((val & 3u) << 5u);
                if (rRomBank == 0u) rRomBank = 1u;
            } else {
                rRamBank = val & 3u;
            }
        }
        return;
    }
    if (addr < 0x8000u) {
        if (rMbcType != 5u && rMbcType != 6u) rMbcMode = val & 1u;
        return;
    }
    if (addr < 0xA000u) { gbWriteByteAt(GB_VRAM_BASE, addr - 0x8000u, val); return; }
    if (addr < 0xC000u) {
        if (rMbcType == 5u || rMbcType == 6u) gbWriteByteAt(GB_ERAM_BASE, (addr - 0xA000u) & 0x01FFu, (val & 0x0Fu) | 0xF0u);
        else gbWriteByteAt(GB_ERAM_BASE, (addr - 0xA000u) & 0x1FFFu, val);
        return;
    }
    if (addr < 0xFE00u) { gbWriteByteAt(GB_WRAM_BASE, (addr - 0xC000u) & 0x1FFFu, val); return; }
    if (addr < 0xFEA0u) { gbWriteByteAt(GB_OAM_BASE, addr - 0xFE00u, val); return; }
    if (addr < 0xFF00u) return;
    if (addr < 0xFF80u) {
        if (addr == 0xFF00u) { rJoypSel = val & 0x30u; return; }
        if (addr == 0xFF04u) { rDIV = 0u; return; }
        if (addr == 0xFF05u) { rTIMA = val; return; }
        if (addr == 0xFF06u) { rTMA = val; return; }
        if (addr == 0xFF07u) { rTAC = val & 7u; return; }
        if (addr == 0xFF0Fu) { rIF = val & 0x1Fu; return; }
        if (addr == 0xFF40u) { rLCDC = val; return; }
        if (addr == 0xFF41u) { rSTAT = (val & 0x78u) | (rSTAT & 0x07u); return; }
        if (addr == 0xFF42u) { rSCY = val; return; }
        if (addr == 0xFF43u) { rSCX = val; return; }
        if (addr == 0xFF44u) { return; }
        if (addr == 0xFF45u) { rLYC = val; return; }
        if (addr == 0xFF46u) { rDmaSrc = (val << 8u) | 0x10000u; return; }
        if (addr == 0xFF47u) { rBGP = val; return; }
        if (addr == 0xFF48u) { rOBP0 = val; return; }
        if (addr == 0xFF49u) { rOBP1 = val; return; }
        if (addr == 0xFF4Au) { rWY = val; return; }
        if (addr == 0xFF4Bu) { rWX = val; return; }
        gbWriteByteAt(GB_IO_BASE, addr - 0xFF00u, val);
        return;
    }
    if (addr < 0xFFFFu) { gbWriteByteAt(GB_HRAM_BASE, addr - 0xFF80u, val); return; }
    rIE = val;
}

// Pure register helpers (NO memRead/memWrite calls inside -> zero inlining bloat!)
uint getReg8Pure(uint idx, uint hlVal) {
    if (idx < 4u) return (rBCDE >> (idx * 8u)) & 0xFFu;
    if (idx == 4u) return (rHL >> 8u) & 0xFFu;
    if (idx == 5u) return rHL & 0xFFu;
    if (idx == 6u) return hlVal;
    return rA;
}

void setReg8Pure(uint idx, uint val, inout int wrAddr, inout uint wrVal) {
    val &= 0xFFu;
    if (idx < 4u) {
        uint sh = idx * 8u;
        rBCDE = (rBCDE & ~(0xFFu << sh)) | (val << sh);
    } else if (idx == 4u) {
        rHL = (rHL & 0x00FFu) | (val << 8u);
    } else if (idx == 5u) {
        rHL = (rHL & 0xFF00u) | val;
    } else if (idx == 6u) {
        wrAddr = int(rHL);
        wrVal = val;
    } else {
        rA = val;
    }
}

void aluOp8(uint aluIdx, uint v) {
    uint cIn = (rF & FLAG_C) != 0u ? 1u : 0u;
    if (aluIdx == 0u || aluIdx == 1u) {
        uint c = (aluIdx == 1u) ? cIn : 0u;
        uint res = rA + v + c;
        uint hc = (rA & 0xFu) + (v & 0xFu) + c;
        rF = (((res & 0xFFu) == 0u) ? FLAG_Z : 0u) | ((hc > 0xFu) ? FLAG_H : 0u) | ((res > 0xFFu) ? FLAG_C : 0u);
        rA = res & 0xFFu;
    } else if (aluIdx == 2u || aluIdx == 3u || aluIdx == 7u) {
        uint c = (aluIdx == 3u) ? cIn : 0u;
        int res = int(rA) - int(v) - int(c);
        int hc = int(rA & 0xFu) - int(v & 0xFu) - int(c);
        uint r8 = uint(res) & 0xFFu;
        rF = FLAG_N | ((r8 == 0u) ? FLAG_Z : 0u) | ((hc < 0) ? FLAG_H : 0u) | ((res < 0) ? FLAG_C : 0u);
        if (aluIdx != 7u) rA = r8;
    } else if (aluIdx == 4u) {
        rA = (rA & v) & 0xFFu;
        rF = FLAG_H | ((rA == 0u) ? FLAG_Z : 0u);
    } else if (aluIdx == 5u) {
        rA = (rA ^ v) & 0xFFu;
        rF = (rA == 0u) ? FLAG_Z : 0u;
    } else {
        rA = (rA | v) & 0xFFu;
        rF = (rA == 0u) ? FLAG_Z : 0u;
    }
}

uint stepCPU(uint one) {
    int wrAddr0 = -1;
    uint wrVal0 = 0u;
    int wrAddr1 = -1;
    uint wrVal1 = 0u;
    uint wrCount = 0u;
    uint cycles = 4u;

    uint pending = rIE & rIF & 0x1Fu;
    bool tookIrq = false;
    if (pending != 0u) {
        rHalted = 0u;
        if (rIME != 0u) {
            rIME = 0u;
            uint vec = 0x40u;
            uint bit = 0x01u;
            if ((pending & 0x01u) != 0u)      { bit = 0x01u; vec = 0x40u; }
            else if ((pending & 0x02u) != 0u) { bit = 0x02u; vec = 0x48u; }
            else if ((pending & 0x04u) != 0u) { bit = 0x04u; vec = 0x50u; }
            else if ((pending & 0x08u) != 0u) { bit = 0x08u; vec = 0x58u; }
            else                              { bit = 0x10u; vec = 0x60u; }
            rIF &= ~bit;
            rSP = (rSP - 2u) & 0xFFFFu;
            wrAddr0 = int(rSP);
            wrVal0  = rPC & 0xFFu;
            wrAddr1 = int((rSP + 1u) & 0xFFFFu);
            wrVal1  = (rPC >> 8u) & 0xFFu;
            wrCount = 2u * one;
            rPC = vec;
            cycles = 20u;
            tookIrq = true;
        }
    }

    if (!tookIrq && rHalted == 0u) {
        uint op = 0u, b1 = 0u, b2 = 0u, d16 = 0u;
        uint memVal = 0u, popHi = 0u;
        uint hl = getHL();
        int rdAddr0 = -1;
        int rdAddr1 = -1;

        // ONE unified memRead call site for instruction fetch + indirect/stack reads!
        uint rMax = 5u * one;
        for (uint r = 0u; r < rMax; r++) {
            uint rAddr = 0u;
            if (r < 3u) {
                rAddr = (rPC + r) & 0xFFFFu;
            } else if (r == 3u) {
                if (rdAddr0 < 0) break;
                rAddr = uint(rdAddr0);
            } else {
                if (rdAddr1 < 0) break;
                rAddr = uint(rdAddr1);
            }

            uint val = memRead(rAddr);

            if (r == 0u) op = val;
            else if (r == 1u) b1 = val;
            else if (r == 2u) {
                b2 = val;
                d16 = (b2 << 8u) | b1;
                if (op >= 0x40u && op <= 0xBFu) {
                    if ((op & 7u) == 6u) rdAddr0 = int(hl);
                } else if (op == 0x34u || op == 0x35u || op == 0x2Au || op == 0x3Au) {
                    rdAddr0 = int(hl);
                } else if (op == 0xCBu && (b1 & 7u) == 6u) {
                    rdAddr0 = int(hl);
                } else if (op == 0x0Au) {
                    rdAddr0 = int(getBC());
                } else if (op == 0x1Au) {
                    rdAddr0 = int(getDE());
                } else if (op == 0xF0u) {
                    rdAddr0 = int(0xFF00u + b1);
                } else if (op == 0xF2u) {
                    rdAddr0 = int(0xFF00u + ((rBCDE >> 8u) & 0xFFu));
                } else if (op == 0xFAu) {
                    rdAddr0 = int(d16);
                } else if ((op & 0xCFu) == 0xC1u || op == 0xC9u || op == 0xD9u || (op & 0xE7u) == 0xC0u) {
                    rdAddr0 = int(rSP);
                    rdAddr1 = int((rSP + 1u) & 0xFFFFu);
                }
            }
            else if (r == 3u) memVal = val;
            else popHi = val;
        }

        rPC = (rPC + 1u) & 0xFFFFu;
        uint popVal = (popHi << 8u) | memVal;
        int wrAddr = -1;
        uint wrVal = 0u;
        int wr16Addr = -1;
        uint wr16Val = 0u;

    // 0x40..0x7F: LD r, r' (and HALT at 0x76)
    if (op >= 0x40u && op <= 0x7Fu) {
        if (op == 0x76u) {
            rHalted = 1u;
        } else {
            uint dst = (op >> 3u) & 7u;
            uint src = op & 7u;
            setReg8Pure(dst, getReg8Pure(src, memVal), wrAddr, wrVal);
            cycles = (dst == 6u || src == 6u) ? 8u : 4u;
        }
    }
    // 0x80..0xBF: ALU A, r
    else if (op >= 0x80u && op <= 0xBFu) {
        uint src = op & 7u;
        aluOp8((op >> 3u) & 7u, getReg8Pure(src, memVal));
        cycles = (src == 6u) ? 8u : 4u;
    }
    // 0x08: LD (a16), SP
    else if (op == 0x08u) {
        rPC = (rPC + 2u) & 0xFFFFu;
        wr16Addr = int(d16);
        wr16Val = rSP;
        cycles = 20u;
    }
    // 16-bit loads & arith
    else if ((op & 0xCFu) == 0x01u) {
        rPC = (rPC + 2u) & 0xFFFFu;
        uint rp = (op >> 4u) & 3u;
        if (rp == 0u) setBC(d16);
        else if (rp == 1u) setDE(d16);
        else if (rp == 2u) setHL(d16);
        else rSP = d16;
        cycles = 12u;
    }
    else if ((op & 0xCFu) == 0x09u) {
        uint rp = (op >> 4u) & 3u;
        uint v = (rp == 0u) ? getBC() : (rp == 1u) ? getDE() : (rp == 2u) ? hl : rSP;
        uint res = hl + v;
        uint hc = (hl & 0xFFFu) + (v & 0xFFFu);
        rF = (rF & FLAG_Z) | ((hc > 0xFFFu) ? FLAG_H : 0u) | ((res > 0xFFFFu) ? FLAG_C : 0u);
        setHL(res & 0xFFFFu);
        cycles = 8u;
    }
    else if ((op & 0xCFu) == 0x03u || (op & 0xCFu) == 0x0Bu) {
        uint rp = (op >> 4u) & 3u;
        uint d = ((op & 0x08u) == 0u) ? 1u : 0xFFFFu;
        if (rp == 0u) setBC((getBC() + d) & 0xFFFFu);
        else if (rp == 1u) setDE((getDE() + d) & 0xFFFFu);
        else if (rp == 2u) setHL((hl + d) & 0xFFFFu);
        else rSP = (rSP + d) & 0xFFFFu;
        cycles = 8u;
    }
    // 8-bit INC / DEC / LD r, d8
    else if ((op & 0xC7u) == 0x04u) {
        uint reg = (op >> 3u) & 7u;
        uint v = getReg8Pure(reg, memVal);
        uint res = (v + 1u) & 0xFFu;
        rF = (rF & FLAG_C) | ((res == 0u) ? FLAG_Z : 0u) | (((v & 0xFu) == 0xFu) ? FLAG_H : 0u);
        setReg8Pure(reg, res, wrAddr, wrVal);
        cycles = (reg == 6u) ? 12u : 4u;
    }
    else if ((op & 0xC7u) == 0x05u) {
        uint reg = (op >> 3u) & 7u;
        uint v = getReg8Pure(reg, memVal);
        uint res = (v - 1u) & 0xFFu;
        rF = (rF & FLAG_C) | FLAG_N | ((res == 0u) ? FLAG_Z : 0u) | (((v & 0xFu) == 0u) ? FLAG_H : 0u);
        setReg8Pure(reg, res, wrAddr, wrVal);
        cycles = (reg == 6u) ? 12u : 4u;
    }
    else if ((op & 0xC7u) == 0x06u) {
        rPC = (rPC + 1u) & 0xFFFFu;
        uint reg = (op >> 3u) & 7u;
        setReg8Pure(reg, b1, wrAddr, wrVal);
        cycles = (reg == 6u) ? 12u : 8u;
    }
    // Indirect loads
    else if (op == 0x02u) { wrAddr = int(getBC()); wrVal = rA; cycles = 8u; }
    else if (op == 0x12u) { wrAddr = int(getDE()); wrVal = rA; cycles = 8u; }
    else if (op == 0x22u) { wrAddr = int(hl); wrVal = rA; setHL((hl + 1u) & 0xFFFFu); cycles = 8u; }
    else if (op == 0x32u) { wrAddr = int(hl); wrVal = rA; setHL((hl - 1u) & 0xFFFFu); cycles = 8u; }
    else if (op == 0x0Au || op == 0x1Au) { rA = memVal; cycles = 8u; }
    else if (op == 0x2Au) { rA = memVal; setHL((hl + 1u) & 0xFFFFu); cycles = 8u; }
    else if (op == 0x3Au) { rA = memVal; setHL((hl - 1u) & 0xFFFFu); cycles = 8u; }
    // Accumulator rotates & flags
    else if (op == 0x07u) { uint cOut = (rA >> 7u) & 1u; rA = ((rA << 1u) | cOut) & 0xFFu; rF = (cOut != 0u) ? FLAG_C : 0u; }
    else if (op == 0x0Fu) { uint cOut = rA & 1u; rA = ((rA >> 1u) | (cOut << 7u)) & 0xFFu; rF = (cOut != 0u) ? FLAG_C : 0u; }
    else if (op == 0x17u) { uint cIn = (rF & FLAG_C) != 0u ? 1u : 0u; uint cOut = (rA >> 7u) & 1u; rA = ((rA << 1u) | cIn) & 0xFFu; rF = (cOut != 0u) ? FLAG_C : 0u; }
    else if (op == 0x1Fu) { uint cIn = (rF & FLAG_C) != 0u ? 1u : 0u; uint cOut = rA & 1u; rA = ((rA >> 1u) | (cIn << 7u)) & 0xFFu; rF = (cOut != 0u) ? FLAG_C : 0u; }
    else if (op == 0x27u) {
        uint a = rA;
        if ((rF & FLAG_N) == 0u) {
            if ((rF & FLAG_C) != 0u || a > 0x99u) { a += 0x60u; rF |= FLAG_C; }
            if ((rF & FLAG_H) != 0u || (a & 0x0Fu) > 0x09u) { a += 0x06u; }
        } else {
            if ((rF & FLAG_C) != 0u) a -= 0x60u;
            if ((rF & FLAG_H) != 0u) a -= 0x06u;
        }
        rA = a & 0xFFu;
        rF = (rF & (FLAG_N | FLAG_C)) | ((rA == 0u) ? FLAG_Z : 0u);
    }
    else if (op == 0x2Fu) { rA = (~rA) & 0xFFu; rF |= (FLAG_N | FLAG_H); }
    else if (op == 0x37u) { rF = (rF & FLAG_Z) | FLAG_C; }
    else if (op == 0x3Fu) { rF = (rF & FLAG_Z) | (((rF & FLAG_C) != 0u) ? 0u : FLAG_C); }
    // Relative Jumps (JR)
    else if (op == 0x18u || (op & 0xE7u) == 0x20u) {
        rPC = (rPC + 1u) & 0xFFFFu;
        int rel = (b1 >= 128u) ? int(b1) - 256 : int(b1);
        bool cond = true;
        if (op == 0x20u) cond = (rF & FLAG_Z) == 0u;
        else if (op == 0x28u) cond = (rF & FLAG_Z) != 0u;
        else if (op == 0x30u) cond = (rF & FLAG_C) == 0u;
        else if (op == 0x38u) cond = (rF & FLAG_C) != 0u;
        if (cond) { rPC = uint(int(rPC) + rel) & 0xFFFFu; cycles = 12u; }
        else cycles = 8u;
    }
    // Immediate ALU
    else if ((op & 0xC7u) == 0xC6u) {
        rPC = (rPC + 1u) & 0xFFFFu;
        aluOp8((op >> 3u) & 7u, b1);
        cycles = 8u;
    }
    // Stack POP / PUSH
    else if ((op & 0xCFu) == 0xC1u) {
        rSP = (rSP + 2u) & 0xFFFFu;
        uint rp = (op >> 4u) & 3u;
        if (rp == 0u) setBC(popVal);
        else if (rp == 1u) setDE(popVal);
        else if (rp == 2u) setHL(popVal);
        else setAF(popVal);
        cycles = 12u;
    }
    else if ((op & 0xCFu) == 0xC5u) {
        uint rp = (op >> 4u) & 3u;
        uint v = (rp == 0u) ? getBC() : (rp == 1u) ? getDE() : (rp == 2u) ? hl : getAF();
        rSP = (rSP - 2u) & 0xFFFFu;
        wr16Addr = int(rSP);
        wr16Val = v;
        cycles = 16u;
    }
    // JP / CALL / RET / RST
    else if (op == 0xC3u || (op & 0xE7u) == 0xC2u) {
        rPC = (rPC + 2u) & 0xFFFFu;
        bool cond = true;
        if (op == 0xC2u) cond = (rF & FLAG_Z) == 0u;
        else if (op == 0xCAu) cond = (rF & FLAG_Z) != 0u;
        else if (op == 0xD2u) cond = (rF & FLAG_C) == 0u;
        else if (op == 0xDAu) cond = (rF & FLAG_C) != 0u;
        if (cond) { rPC = d16; cycles = 16u; }
        else cycles = 12u;
    }
    else if (op == 0xE9u) { rPC = hl; cycles = 4u; }
    else if (op == 0xCDu || (op & 0xE7u) == 0xC4u) {
        rPC = (rPC + 2u) & 0xFFFFu;
        bool cond = true;
        if (op == 0xC4u) cond = (rF & FLAG_Z) == 0u;
        else if (op == 0xCCu) cond = (rF & FLAG_Z) != 0u;
        else if (op == 0xD4u) cond = (rF & FLAG_C) == 0u;
        else if (op == 0xDCu) cond = (rF & FLAG_C) != 0u;
        if (cond) {
            rSP = (rSP - 2u) & 0xFFFFu;
            wr16Addr = int(rSP);
            wr16Val = rPC;
            rPC = d16;
            cycles = 24u;
        } else {
            cycles = 12u;
        }
    }
    else if (op == 0xC9u || op == 0xD9u) {
        rSP = (rSP + 2u) & 0xFFFFu;
        rPC = popVal;
        if (op == 0xD9u) rIME = 1u;
        cycles = 16u;
    }
    else if ((op & 0xE7u) == 0xC0u) {
        bool cond = false;
        if (op == 0xC0u) cond = (rF & FLAG_Z) == 0u;
        else if (op == 0xC8u) cond = (rF & FLAG_Z) != 0u;
        else if (op == 0xD0u) cond = (rF & FLAG_C) == 0u;
        else if (op == 0xD8u) cond = (rF & FLAG_C) != 0u;
        if (cond) { rSP = (rSP + 2u) & 0xFFFFu; rPC = popVal; cycles = 20u; }
        else cycles = 8u;
    }
    else if ((op & 0xC7u) == 0xC7u) {
        rSP = (rSP - 2u) & 0xFFFFu;
        wr16Addr = int(rSP);
        wr16Val = rPC;
        rPC = op & 0x38u;
        cycles = 16u;
    }
    // High RAM & I/O loads
    else if (op == 0xE0u) { rPC = (rPC + 1u) & 0xFFFFu; wrAddr = int(0xFF00u + b1); wrVal = rA; cycles = 12u; }
    else if (op == 0xF0u) { rPC = (rPC + 1u) & 0xFFFFu; rA = memVal; cycles = 12u; }
    else if (op == 0xE2u) { wrAddr = int(0xFF00u + ((rBCDE >> 8u) & 0xFFu)); wrVal = rA; cycles = 8u; }
    else if (op == 0xF2u) { rA = memVal; cycles = 8u; }
    else if (op == 0xEAu) { rPC = (rPC + 2u) & 0xFFFFu; wrAddr = int(d16); wrVal = rA; cycles = 16u; }
    else if (op == 0xFAu) { rPC = (rPC + 2u) & 0xFFFFu; rA = memVal; cycles = 16u; }
    // SP arithmetic
    else if (op == 0xE8u || op == 0xF8u) {
        rPC = (rPC + 1u) & 0xFFFFu;
        int rel = (b1 >= 128u) ? int(b1) - 256 : int(b1);
        uint res = uint(int(rSP) + rel) & 0xFFFFu;
        rF = (((rSP & 0xFu) + (b1 & 0xFu)) > 0xFu ? FLAG_H : 0u)
           | (((rSP & 0xFFu) + b1) > 0xFFu ? FLAG_C : 0u);
        if (op == 0xE8u) { rSP = res; cycles = 16u; }
        else { setHL(res); cycles = 12u; }
    }
    else if (op == 0xF9u) { rSP = hl; cycles = 8u; }
    else if (op == 0xF3u) { rIME = 0u; }
    else if (op == 0xFBu) { rIME = 1u; }
    else if (op == 0xCBu) {
        rPC = (rPC + 1u) & 0xFFFFu;
        uint reg = b1 & 7u;
        uint val = getReg8Pure(reg, memVal);
        uint grp = b1 >> 6u;
        uint sub = (b1 >> 3u) & 7u;
        if (grp == 1u) {
            bool z = ((val >> sub) & 1u) == 0u;
            rF = (rF & FLAG_C) | FLAG_H | (z ? FLAG_Z : 0u);
            cycles = (reg == 6u) ? 12u : 8u;
        } else {
            uint res = 0u;
            if (grp == 0u) {
                uint cOut = 0u;
                uint cIn = (rF & FLAG_C) != 0u ? 1u : 0u;
                if (sub == 0u)      { cOut = (val >> 7u) & 1u; res = ((val << 1u) | cOut) & 0xFFu; }
                else if (sub == 1u) { cOut = val & 1u; res = ((val >> 1u) | (cOut << 7u)) & 0xFFu; }
                else if (sub == 2u) { cOut = (val >> 7u) & 1u; res = ((val << 1u) | cIn) & 0xFFu; }
                else if (sub == 3u) { cOut = val & 1u; res = ((val >> 1u) | (cIn << 7u)) & 0xFFu; }
                else if (sub == 4u) { cOut = (val >> 7u) & 1u; res = (val << 1u) & 0xFFu; }
                else if (sub == 5u) { cOut = val & 1u; res = ((val >> 1u) | (val & 0x80u)) & 0xFFu; }
                else if (sub == 6u) { res = (((val & 0x0Fu) << 4u) | ((val >> 4u) & 0x0Fu)) & 0xFFu; }
                else                { cOut = val & 1u; res = (val >> 1u) & 0xFFu; }
                rF = ((res == 0u) ? FLAG_Z : 0u) | ((cOut != 0u) ? FLAG_C : 0u);
            } else if (grp == 2u) {
                res = val & ~(1u << sub);
            } else {
                res = val | (1u << sub);
            }
            setReg8Pure(reg, res, wrAddr, wrVal);
            cycles = (reg == 6u) ? 16u : 8u;
        }
    }

        // Unified memory write setup
        if (wrAddr >= 0) {
            wrAddr0 = wrAddr;
            wrVal0  = wrVal;
            wrCount = 1u * one;
        } else if (wr16Addr >= 0) {
            wrAddr0 = wr16Addr;
            wrVal0  = wr16Val & 0xFFu;
            wrAddr1 = (wr16Addr + 1) & 0xFFFF;
            wrVal1  = (wr16Val >> 8u) & 0xFFu;
            wrCount = 2u * one;
        }
    }

    // All 8-bit, 16-bit, and interrupt writes share this ONE memWrite call!
    for (uint w = 0u; w < wrCount; w++) {
        memWrite(uint(w == 0u ? wrAddr0 : wrAddr1), (w == 0u) ? wrVal0 : wrVal1);
    }

    return cycles;
}

void stepTimers(uint cycles) {
    rDIV = (rDIV + cycles) & 0xFFFFu;
    if ((rTAC & 4u) != 0u) {
        uint sel = rTAC & 3u;
        uint step = (sel == 1u) ? 16u : (sel == 2u) ? 64u : (sel == 3u) ? 256u : 1024u;
        if (((rDIV - cycles) / step) != (rDIV / step)) {
            rTIMA++;
            if (rTIMA > 0xFFu) {
                rTIMA = rTMA;
                rIF |= 0x04u;
            }
        }
    }
}

// -----------------------------------------------------------------------------
// 144-Thread Parallel DMG-01 Scanline PPU Renderer (1 GPU Thread per Scanline!)
// -----------------------------------------------------------------------------
void renderScanlineParallel(uint line, uvec2 regs, uint one) {
    uint lcdc = regs.x & 0xFFu;
    uint bgp  = (regs.x >> 8u) & 0xFFu;
    uint obp0 = (regs.x >> 16u) & 0xFFu;
    uint obp1 = (regs.x >> 24u) & 0xFFu;
    uint scx  = regs.y & 0xFFu;
    uint scy  = (regs.y >> 8u) & 0xFFu;
    uint wx   = (regs.y >> 16u) & 0xFFu;
    uint wy   = (regs.y >> 24u) & 0xFFu;

    uint wordCount = 40u * one;
    if ((lcdc & 0x80u) == 0u) {
        for (uint w = 0u; w < wordCount; w++) {
            c.atlas[GB_LCD_BASE + line * 40u + w] = 0u;
        }
        return;
    }

    bool bgEnable     = (lcdc & 0x01u) != 0u;
    bool objEnable    = (lcdc & 0x02u) != 0u;
    bool objTall      = (lcdc & 0x04u) != 0u;
    uint bgMapBase    = ((lcdc & 0x08u) != 0u) ? 0x1C00u : 0x1800u;
    bool unsignedData = (lcdc & 0x10u) != 0u;
    bool winEnable    = ((lcdc & 0x20u) != 0u) && (line >= wy) && (wx <= 166u);
    uint winMapBase   = ((lcdc & 0x40u) != 0u) ? 0x1C00u : 0x1800u;
    uint spriteH      = objTall ? 16u : 8u;

    // Pre-filter the 40 OAM sprites ONCE for this scanline into a 2-register 40-bit mask!
    uvec2 hitMask = uvec2(0u, 0u);
    uint hitCount = 0u;
    if (objEnable) {
        uint maxOam = 40u * one;
        for (uint s = 0u; s < maxOam; s++) {
            int sy = int(sOAM[s] & 0xFFu) - 16;
            if (int(line) >= sy && int(line) < sy + int(spriteH)) {
                if (s < 32u) hitMask.x |= (1u << s);
                else         hitMask.y |= (1u << (s - 32u));
                hitCount++;
                if (hitCount >= 10u) break;
            }
        }
    }

    uint subMax = 4u * one;
    for (uint wordX = 0u; wordX < wordCount; wordX++) {
        uint packedWord = 0u;

        for (uint sub = 0u; sub < subMax; sub++) {
            uint x = (wordX << 2u) + sub;
            uint bgColorId = 0u;
            uint shade = bgp & 3u;

            if (bgEnable) {
                bool inWin = winEnable && (int(x) >= int(wx) - 7);
                uint mapY = inWin ? (line - wy) : ((line + scy) & 0xFFu);
                uint mapX = inWin ? uint(int(x) - (int(wx) - 7)) : ((x + scx) & 0xFFu);
                uint mapAddr = (inWin ? winMapBase : bgMapBase) + ((mapY >> 3u) * 32u) + (mapX >> 3u);
                uint tileIdx = gbReadByteAt(GB_VRAM_BASE, mapAddr);

                uint tileAddr = unsignedData
                    ? (tileIdx * 16u)
                    : uint(0x1000 + ((tileIdx >= 128u) ? (int(tileIdx) - 256) : int(tileIdx)) * 16);

                uint rowAddr = tileAddr + ((mapY & 7u) * 2u);
                uint lo = gbReadByteAt(GB_VRAM_BASE, rowAddr);
                uint hi = gbReadByteAt(GB_VRAM_BASE, rowAddr + 1u);
                uint bit = 7u - (mapX & 7u);
                bgColorId = ((lo >> bit) & 1u) | (((hi >> bit) & 1u) << 1u);
                shade = (bgp >> (bgColorId * 2u)) & 3u;
            }

            uvec2 mask = hitMask;
            while ((mask.x | mask.y) != 0u) {
                uint s = 0u;
                if (mask.x != 0u) {
                    s = uint(findLSB(mask.x));
                    mask.x &= mask.x - 1u;
                } else {
                    s = 32u + uint(findLSB(mask.y));
                    mask.y &= mask.y - 1u;
                }
                uint w = sOAM[s];
                int sx = int((w >> 8u) & 0xFFu) - 8;
                if (int(x) >= sx && int(x) < sx + 8) {
                    int sy = int(w & 0xFFu) - 16;
                    uint tile = (w >> 16u) & 0xFFu;
                    uint attr = (w >> 24u) & 0xFFu;
                    if (objTall) tile &= 0xFEu;

                    uint py = uint(int(line) - sy);
                    uint px = uint(int(x) - sx);
                    if ((attr & 0x40u) != 0u) py = (spriteH - 1u) - py;
                    if ((attr & 0x20u) != 0u) px = 7u - px;

                    uint rowAddr = tile * 16u + py * 2u;
                    uint lo = gbReadByteAt(GB_VRAM_BASE, rowAddr);
                    uint hi = gbReadByteAt(GB_VRAM_BASE, rowAddr + 1u);
                    uint bit = 7u - px;
                    uint objColorId = ((lo >> bit) & 1u) | (((hi >> bit) & 1u) << 1u);

                    if (objColorId != 0u) {
                        bool bgPrio = (attr & 0x80u) != 0u;
                        if (!bgPrio || bgColorId == 0u) {
                            uint pal = ((attr & 0x10u) != 0u) ? obp1 : obp0;
                            shade = (pal >> (objColorId * 2u)) & 3u;
                        }
                        break;
                    }
                }
            }

            packedWord |= (shade & 3u) << (sub * 8u);
        }

        c.atlas[GB_LCD_BASE + line * 40u + wordX] = packedWord;
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    if (tid == 0u) {
        sDoRender = 0u;
    }
    barrier();

    if (tid == 0u) {
        uint pressed = hbPressed();
        uint buttons = hbButtons();
        gButtons = buttons;
        c.motion.x += 1.0 / 60.0;
        c.motion.w += 1.0;

        // Universal Exit: Press MINUS to return to Homebrew Launcher
        if ((pressed & HB_MINUS) != 0u) {
            hbExit();
            hbEndFrame();
        } else {
            // X Button: Cycle GameBoy Color Palettes (Classic Olive -> Pocket Gray -> SGB Amber)
            if ((pressed & HB_X) != 0u) {
                uint palMode = (uint(c.transition.x) + 1u) % 3u;
                c.transition.x = float(palMode);
                hbVibrate(2u, 25u, 150u);
            }

            // Y Button: Toggle Cartridge ROM Selector Menu (c.reserved.x: 0 = Menu Open, 1 = Playing)
            if ((pressed & HB_Y) != 0u) {
                c.reserved.x = (c.reserved.x == 0u) ? 1u : 0u;
                if (c.reserved.x == 0u && !hbBusy()) {
                    hbFsListRoms();
                }
                hbVibrate(2u, 30u, 180u);
                hbEndFrame();
            } else {
                // Auto-fetch ROM list on app entry (c.stats.w == 0u) or if ROM catalog is empty
                if (c.reserved.x == 0u && (c.stats.w == 0u || gbRomCount() == 0u) && !hbBusy()) {
                    if (hbFsListRoms()) {
                        c.stats.w = 1u;
                    }
                }

                // -------------------------------------------------------------
                // MODE A: CARTRIDGE ROM PICKER MENU OPEN (c.reserved.x == 0u)
                // -------------------------------------------------------------
                if (c.reserved.x == 0u) {
                    uint rawCount = gbRomCount();
                    if (rawCount > 0u) {
                        uint romCount = clamp(rawCount, 1u, 16u);
                        uint sel = c.reserved.y;
                        if (sel >= romCount) sel = 0u;

                        if ((pressed & HB_DOWN) != 0u) {
                            sel = (sel + 1u) % romCount;
                        }
                        if ((pressed & HB_UP) != 0u) {
                            sel = (sel + romCount - 1u) % romCount;
                        }
                        c.reserved.y = sel;

                        // Press A to download selected ROM to tmp:/ and boot it!
                        if ((pressed & HB_A) != 0u && !hbBusy()) {
                            if (hbFsLoadRom(sel)) {
                                c.reserved.x = 2u; // Waiting for ROM download & GPU load to finish
                            }
                        }
                    }
                    hbEndFrame();
                }
                // Waiting for hbFsLoadRom(sel) to complete on host
                else if (c.reserved.x == 2u) {
                    if (!hbBusy()) {
                        c.reserved.x = 1u; // Start playing!
                    }
                    hbEndFrame();
                }
                // -------------------------------------------------------------
                // MODE B: REAL SHARP LR35902 .GB ROM EMULATOR (ROM_LOADED == 1)
                // -------------------------------------------------------------
                else if (c.atlas[GB_CPU_BASE + 31u] == 1u) {
                    uint one = c.atlas[GB_CPU_BASE + 31u]; // Runtime 1u prevents spirv-opt loop unrolling
                    loadCPUState();

                    uint totalLines = 154u * one;
                    uint maxSteps   = 114u * one;
                    uint dmaWords   = 40u * one;

                    // Execute 154 scanlines (70,224 T-cycles per 60Hz frame)
                    for (uint line = 0u; line < totalLines; line++) {
                        rLY = line;

                        if (rLY == rLYC) {
                            rSTAT |= 0x04u;
                            if ((rSTAT & 0x40u) != 0u) rIF |= 0x02u;
                        } else {
                            rSTAT &= ~0x04u;
                        }

                        if (line < 144u) {
                            rSTAT = (rSTAT & 0xFCu) | 2u; // Mode 2: OAM Scan (80 cycles)
                            if ((rSTAT & 0x20u) != 0u) rIF |= 0x02u;
                        } else if (line == 144u) {
                            rSTAT = (rSTAT & 0xFCu) | 1u; // Mode 1: VBlank
                            rIF |= 0x01u;                 // VBlank Interrupt ($40)
                            if ((rSTAT & 0x10u) != 0u) rIF |= 0x02u;
                        }

                        bool latchedLine = false;
                        uint lineCycles = 0u;
                        for (uint step = 0u; step < maxSteps; step++) {
                            if (lineCycles >= 456u) break;

                            if (line < 144u) {
                                if (lineCycles >= 252u && (rSTAT & 3u) != 0u) {
                                    rSTAT = (rSTAT & 0xFCu) | 0u; // Mode 0: HBlank (204 cycles)
                                    if ((rSTAT & 0x08u) != 0u) rIF |= 0x02u;
                                } else if (lineCycles >= 80u && lineCycles < 252u && (rSTAT & 3u) != 3u) {
                                    rSTAT = (rSTAT & 0xFCu) | 3u; // Mode 3: Drawing (172 cycles)
                                    sLineRegs[line] = uvec2(
                                        (rLCDC & 0xFFu) | ((rBGP & 0xFFu) << 8u) | ((rOBP0 & 0xFFu) << 16u) | ((rOBP1 & 0xFFu) << 24u),
                                        (rSCX & 0xFFu)  | ((rSCY & 0xFFu) << 8u) | ((rWX & 0xFFu) << 16u)   | ((rWY & 0xFFu) << 24u)
                                    );
                                    latchedLine = true;
                                }
                            }

                            uint cyc = stepCPU(one);
                            lineCycles += cyc;
                            stepTimers(cyc);

                            if ((rDmaSrc & 0x10000u) != 0u) {
                                uint src = rDmaSrc & 0xFF00u;
                                rDmaSrc = 0u;
                                uint srcWordBase = GB_WRAM_BASE + ((src & 0x1FFFu) >> 2u);
                                if (src < 0x4000u) {
                                    srcWordBase = GB_ROM_BASE + (src >> 2u);
                                } else if (src < 0x8000u) {
                                    srcWordBase = GB_ROM_BASE + ((((max(rRomBank, 1u) & 15u) * 0x4000u) + (src - 0x4000u)) >> 2u);
                                } else if (src < 0xA000u) {
                                    srcWordBase = GB_VRAM_BASE + ((src - 0x8000u) >> 2u);
                                } else if (src < 0xC000u) {
                                    srcWordBase = GB_ERAM_BASE + ((src - 0xA000u) >> 2u);
                                }
                                for (uint i = 0u; i < dmaWords; i++) {
                                    c.atlas[GB_OAM_BASE + i] = c.atlas[srcWordBase + i];
                                }
                            }
                        }

                        if (line < 144u && !latchedLine) {
                            sLineRegs[line] = uvec2(
                                (rLCDC & 0xFFu) | ((rBGP & 0xFFu) << 8u) | ((rOBP0 & 0xFFu) << 16u) | ((rOBP1 & 0xFFu) << 24u),
                                (rSCX & 0xFFu)  | ((rSCY & 0xFFu) << 8u) | ((rWX & 0xFFu) << 16u)   | ((rWY & 0xFFu) << 24u)
                            );
                        }
                    }

                    saveCPUState();
                    hbEndFrame();
                    sDoRender = 1u;
                }
                // -------------------------------------------------------------
                // MODE C: BUILT-IN "SUPER S2 LAND" PLATFORMER (entry #0)
                // -------------------------------------------------------------
                else {
                    uint state = c.game.x;
                    uint score = c.game.y;
                    uint coins = c.game.z;
                    uint lives = c.game.w;

                    float px = c.flow.x;
                    float py = c.flow.y;
                    float vx = c.flow.z;
                    float vy = c.flow.w;

                    if (state == 0u) {
                        state = 1u;
                        score = 0u;
                        coins = 0u;
                        lives = 3u;
                        px = 28.0;
                        py = 104.0;
                        vx = 0.0;
                        vy = 0.0;
                        c.piece = ivec4(0, 0, 1, 0);
                        c.stats = uvec4(120u, 1u, 200u, 1u);
                    }

                    if (lives == 0u) {
                        if ((pressed & (HB_A | HB_PLUS)) != 0u) {
                            c.game.x = 0u;
                            hbVibrate(0u, 45u, 320u);
                        }
                        hbEndFrame();
                    } else {
                        vec2 stick = hbStick(false);
                        float moveX = 0.0;
                        if ((buttons & HB_LEFT)  != 0u || stick.x < -0.25) moveX -= 1.0;
                        if ((buttons & HB_RIGHT) != 0u || stick.x >  0.25) moveX += 1.0;

                        float runSpeed = ((buttons & HB_B) != 0u) ? 2.1 : 1.4;
                        vx = mix(vx, moveX * runSpeed, 0.35);

                        if (abs(moveX) > 0.1) {
                            c.piece.z = (moveX > 0.0) ? 1 : -1;
                            c.piece.y += 1;
                        } else {
                            c.piece.y = 0;
                        }

                        if ((pressed & HB_A) != 0u && c.piece.w == 1) {
                            vy = -4.35;
                            c.piece.w = 0;
                            hbVibrate(1u, 18u, 220u);
                        }

                        vy += 0.22;
                        px += vx;
                        py += vy;

                        px = clamp(px, 12.0, 260.0);
                        c.piece.x = int(clamp(px - 64.0, 0.0, 112.0));
                        c.piece.w = 0;

                        if (vy > 0.0 && px >= 76.0 && px <= 134.0 && py >= 82.0 && py <= 88.0) {
                            py = 84.0;
                            vy = 0.0;
                            c.piece.w = 1;
                        }
                        if (vy > 0.0 && px >= 166.0 && px <= 234.0 && py >= 62.0 && py <= 68.0) {
                            py = 64.0;
                            vy = 0.0;
                            c.piece.w = 1;
                        }
                        if (py >= 112.0) {
                            py = 112.0;
                            vy = 0.0;
                            c.piece.w = 1;
                        }

                        if ((coins & 1u) == 0u && length(vec2(px, py - 6.0) - vec2(105.0, 68.0)) < 10.0) {
                            coins |= 1u;
                            score += 100u;
                            hbVibrate(1u, 30u, 300u);
                        }
                        if ((coins & 2u) == 0u && length(vec2(px, py - 6.0) - vec2(200.0, 48.0)) < 10.0) {
                            coins |= 2u;
                            score += 200u;
                            hbVibrate(1u, 30u, 300u);
                        }
                        if (coins == 3u && px < 40.0) {
                            coins = 0u;
                            c.stats.x = 130u;
                            c.stats.z = 210u;
                        }

                        int e1x = int(c.stats.x);
                        int e1dir = (c.stats.y == 1u) ? 1 : -1;
                        if (e1x < 500) {
                            e1x += e1dir;
                            if (e1x > 165) c.stats.y = 0u;
                            if (e1x < 75)  c.stats.y = 1u;
                            c.stats.x = uint(e1x);

                            if (abs(px - float(e1x)) < 10.0 && abs(py - 112.0) < 10.0) {
                                if (vy > 0.5) {
                                    vy = -3.4;
                                    score += 250u;
                                    c.stats.x = 999u;
                                    hbVibrate(0u, 40u, 420u);
                                } else {
                                    lives = (lives > 0u) ? (lives - 1u) : 0u;
                                    px = 28.0;
                                    py = 80.0;
                                    vy = -2.0;
                                    hbVibrate(0u, 90u, 700u);
                                }
                            }
                        }

                        int e2x = int(c.stats.z);
                        int e2dir = (c.stats.w == 1u) ? 1 : -1;
                        if (e2x < 500) {
                            e2x += e2dir;
                            if (e2x > 240) c.stats.w = 0u;
                            if (e2x < 140) c.stats.w = 1u;
                            c.stats.z = uint(e2x);
                        }

                        c.game = uvec4(state, score, coins, lives);
                        c.flow = vec4(px, py, vx, vy);
                        hbEndFrame();
                    }
                }
            }
        }
    }

    // Synchronize all 144 GPU threads after Thread 0 finishes CPU frame execution
    barrier();

    if (sDoRender != 0u) {
        if (tid < 40u) {
            sOAM[tid] = c.atlas[GB_OAM_BASE + tid];
        }
        barrier();

        // All 144 GPU threads render their own scanline (0..143) simultaneously!
        uint one = c.atlas[GB_CPU_BASE + 31u];
        renderScanlineParallel(tid, sLineRegs[tid], one);
    }
}
