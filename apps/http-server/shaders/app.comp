#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
#include "abi.glsl"
#include "hb.glsl"

void main(){
 uint pressed=hbPressed();
 c.motion.x+=1.0/60.0;
 c.state.z++;

 // Press X to restart the listening socket
 if((pressed&HB_X)!=0u){
  c.game.x=1u;
  c.piece.x=0;
 }

 // Poll HTTP socket every ~10 frames (~6 times per second) when not busy
 if(c.game.z==1u&&!hbBusy()){
  if(hbResult()==0u&&hbResponseBytes()>=16u){
   c.game.z=2u;
   c.game.w=min(hbFsTextLineCount(),20u);
  }else{
   c.game.z=0u;
  }
 }

 if(c.piece.x<=0&&!hbBusy()){
  if(hbFsHttpPoll(c.game.x)){
   c.game.z=1u;
   c.game.x=0u;
   c.piece.x=10;
  }
 }else if(!hbBusy()){
  c.piece.x--;
 }

 if(((pressed|hbButtons())&HB_MINUS)!=0u)hbExit();
 hbEndFrame();
}
